# Copy this file to .streamlit/secrets.toml for local dev,
# OR paste these values into the Streamlit Cloud dashboard → App Settings → Secrets.
# Never commit secrets.toml to GitHub.

[zoominfo]
username = "you@yourcompany.com"
password = "your-zoominfo-password"
client_id = ""          # optional, required by some ZoomInfo plans
intent_topics = []      # add topics later: ["Cloud Computing", "Azure Virtual Desktop"]

[hubspot]
service_key = "pat-na1-xxxxxxxxxxxxxxxxxxxx"
base_url = "https://api.hubapi.com"
social_engagement_object_type = "2-61559614"   # your custom object type ID
contact_intent_score_property = "event_task_notes"

[salesforce]
username = "you@yourcompany.com"
password = "your-sf-password"
security_token = "your-sf-security-token"
# No Connected App needed — just username, password, and security token.
